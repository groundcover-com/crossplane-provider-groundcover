# Generation cache (terraform schema scratch dir, downloaded provider binaries).
.cache/

# Generated by `make generate` (upjet pipeline + controller-gen). Reproducible from the
# committed config/ + cmd/generator, so not tracked while this is a POC. Productionizing
# (adding the upjet-provider-template base packages) is when these get committed.
apis/
internal/controller/

# Generated CRDs bundled into the package (produced by `make crds`). The hand-written
# package metadata (package/crossplane.yaml) IS tracked.
package/crds/

# Build output (provider binary, built .xpkg).
_output/
