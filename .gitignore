# Generation cache (terraform schema scratch dir, downloaded provider binaries).
.cache/

# Generated by `make generate` (upjet pipeline + controller-gen + angryjet). Reproducible
# from the committed config/ + cmd/generator + the hand-written base scaffolding below, so
# the generated files are not tracked. The hand-written base API types (apis/v1alpha1,
# apis/v1beta1) and the providerconfig controller ARE tracked.
apis/**/zz_*.go
apis/zz_register.go
apis/dashboards/
apis/integrations/
apis/monitoring/
apis/notifications/
internal/controller/**/zz_*.go
internal/controller/zz_setup.go
internal/controller/dashboards/
internal/controller/integrations/
internal/controller/monitoring/
internal/controller/notifications/

# Generated CRDs bundled into the package (produced by `make crds`). The hand-written
# package metadata (package/crossplane.yaml) IS tracked.
package/crds/

# Build output (provider binary, built .xpkg).
_output/
